# Production compose environment template.
# Copy values into .env.prod on the server. .env.prod is intentionally ignored.

# Cloudflare Tunnel must keep pointing at this fixed local endpoint.
NEW_API_BIND=127.0.0.1
NEW_API_PORT=18900

POSTGRES_USER=root
POSTGRES_PASSWORD=change-me
POSTGRES_DB=new-api
SQL_DSN=postgresql://root:change-me@postgres:5432/new-api

REDIS_CONN_STRING=redis://redis
TZ=Asia/Shanghai
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
STREAMING_TIMEOUT=300
